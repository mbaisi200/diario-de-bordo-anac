{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth/$1" },
    { "source": "/api/flights/(.*)", "destination": "/api/flights/$1" },
    { "source": "/api/audit/(.*)", "destination": "/api/audit/$1" },
    { "source": "/api/pilot/(.*)", "destination": "/api/pilot/$1" },
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
